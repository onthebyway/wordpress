SITE_SLUG=example-com
SITE_URL=https://example.com
WORDPRESS_IMAGE=ghcr.io/onthebyway/wordpress:php8.4

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-password

PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=70M
PHP_MAX_EXECUTION_TIME=120
PHP_MAX_INPUT_VARS=3000

WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
WP_SCRIPT_DEBUG=false
WP_DISALLOW_FILE_EDIT=true
WP_AUTO_UPDATE_CORE=minor
WP_ENVIRONMENT_TYPE=production
DISABLE_WP_CRON=true
WP_CRON_RUNNER_ENABLED=true
WP_CRON_INTERVAL_SECONDS=300
WP_REDIS_TIMEOUT=1
WP_REDIS_READ_TIMEOUT=1
REDIS_MAXMEMORY=128mb

NGINX_CLIENT_MAX_BODY_SIZE=70M
NGINX_FASTCGI_CACHE_VALID=1h
NGINX_FASTCGI_CACHE_INACTIVE=24h
NGINX_FASTCGI_CACHE_MAX_SIZE=1g
