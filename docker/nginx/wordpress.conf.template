server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;

    root /var/www/html;
    index index.php index.html;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    location = /.byway-health {
        access_log off;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_connect_timeout 2s;
        fastcgi_read_timeout 2s;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
    }

    location ~* ^/(?:wp-config(?:-docker)?\.php|readme\.html|license\.txt)$ {
        deny all;
    }

    location ~ /\.(?!well-known/) {
        deny all;
    }

    location ~* \.(?:css|js|mjs|jpg|jpeg|gif|png|webp|avif|svg|ico|woff|woff2|ttf|otf|eot)$ {
        try_files $uri =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location ~ \.php$ {
        try_files $uri =404;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_HOST $http_host;
        fastcgi_param HTTP_COOKIE $http_cookie;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTP_X_FORWARDED_FOR $http_x_forwarded_for;
        fastcgi_param HTTP_X_FORWARDED_HOST $http_x_forwarded_host;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_param HTTP_PROXY "";

        fastcgi_pass 127.0.0.1:9000;
        fastcgi_read_timeout ${PHP_MAX_EXECUTION_TIME}s;

        fastcgi_cache WORDPRESS;
        fastcgi_cache_key "$host$request_uri";
        fastcgi_cache_methods GET HEAD;
        fastcgi_cache_min_uses 1;
        fastcgi_cache_valid 200 301 302 404 ${NGINX_FASTCGI_CACHE_VALID};
        fastcgi_cache_lock on;
        fastcgi_cache_lock_timeout 10s;
        fastcgi_cache_background_update on;
        fastcgi_cache_use_stale updating error timeout invalid_header http_500 http_503;
        fastcgi_cache_bypass $skip_cache;
        fastcgi_no_cache $skip_cache $upstream_http_set_cookie;

        add_header X-Cache $upstream_cache_status always;
    }
}
