user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" cache=$upstream_cache_status';
    access_log /dev/stdout main;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    # The upstream reverse proxy performs public response compression and TLS termination.
    gzip off;

    include /etc/nginx/real-ip.conf;

    fastcgi_cache_path /var/cache/nginx/wordpress
        levels=1:2
        keys_zone=WORDPRESS:16m
        inactive=${NGINX_FASTCGI_CACHE_INACTIVE}
        max_size=${NGINX_FASTCGI_CACHE_MAX_SIZE}
        use_temp_path=off;

    map $request_method $skip_cache_method {
        default 1;
        GET 0;
        HEAD 0;
    }

    # Query-string requests are not cached. This safely covers previews,
    # searches, cache-busting requests and plugin-specific actions.
    map $query_string $skip_cache_query {
        default 1;
        "" 0;
    }

    map $request_uri $skip_cache_uri {
        default 0;
        ~*^/wp-admin(?:/|$) 1;
        ~*^/wp-login\.php(?:/|$) 1;
        ~*^/wp-cron\.php(?:/|$) 1;
        ~*^/wp-json(?:/|$) 1;
        ~*^/xmlrpc\.php(?:/|$) 1;
    }

    map $http_cookie $skip_cache_cookie {
        default 0;
        ~*wordpress_logged_in_ 1;
        ~*wp-postpass_ 1;
        ~*comment_author_ 1;
        ~*woocommerce_items_in_cart 1;
        ~*woocommerce_cart_hash 1;
        ~*wp_woocommerce_session_ 1;
    }

    map $http_authorization $skip_cache_authorization {
        default 1;
        "" 0;
    }

    map "$skip_cache_method:$skip_cache_query:$skip_cache_uri:$skip_cache_cookie:$skip_cache_authorization" $skip_cache {
        default 0;
        ~1 1;
    }

    include /etc/nginx/conf.d/*.conf;
}
